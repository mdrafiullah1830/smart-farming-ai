# ============================================================
# Smart Farming AI Platform - Environment Configuration
# ============================================================

# Application
APP_NAME=Smart Farming AI Bangladesh
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=*

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WORKERS=4

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://smartfarming:password@postgres:5432/smart_farming_db
POSTGRES_USER=smartfarming
POSTGRES_PASSWORD=password
POSTGRES_DB=smart_farming_db

# MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=smart_farming_mongo

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# OpenWeatherMap API
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Earth Engine
GEE_SERVICE_ACCOUNT_KEY=path/to/service-account.json

# Firebase
FIREBASE_CREDENTIALS=path/to/firebase-credentials.json

# OpenAI (for Chatbot)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Whisper (for Voice Assistant)
WHISPER_MODEL=base

# TTS (for Bangla Voice)
TTS_MODEL=coqui-tts

# ML Model Paths
CROP_MODEL_PATH=ai_models/trained_models/crop_recommendation.pkl
YIELD_MODEL_PATH=ai_models/trained_models/yield_prediction.pkl
DISEASE_MODEL_PATH=ai_models/trained_models/disease_detection.h5
MARKET_MODEL_PATH=ai_models/trained_models/market_forecasting.pkl

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# SMS Provider (Bangladesh)
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=SmartFarm

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
