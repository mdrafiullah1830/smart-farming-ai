**/node_modules/
**/venv/
**/.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Playwright
# Unanchored: Playwright writes into whichever package ran it, so the
# root-only "/test-results/" form left frontend/test-results/ untracked noise.
/test-results/
/playwright-report/
/blob-report/
/frontend/test-results/
/frontend/playwright-report/
/playwright/.cache/
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

# Secrets — never commit
.env
.env.*
!.env.example
**/.env.local
**/.dev.vars
**/service-account*.json
**/gcp-credentials*.json

# Cloud platform state
.wrangler/
.vercel/
.netlify/
.amplify/

# Flutter
**/.dart_tool/
**/build/
**/.flutter-plugins-dependencies
**/.flutter-plugins
# Everything the Flutter tool regenerates on `flutter build`/`flutter run`.
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/android/.gradle/
**/android/local.properties
frontend/build/

# Databases & caches
*.db
*.db-shm
*.db-wal
database/*.db
database/.fuse_hidden*
**/.cache/

# Trained model artifacts (large, regenerable)
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.tflite
ai_models/trained_models/*
!ai_models/trained_models/.gitkeep

# Prebuilt travel RAG index must ship with the deployable AI service
!apps/ai-service/app/travel/data/index/*.pkl
!apps/ai-service/app/travel/data/index/*.faiss

# ONNX models - ignore in ai_models (regenerable) but track in ai-service (deployable)
ai_models/**/*.onnx
!apps/ai-service/models/*.onnx
!apps/ai-service/models/*.onnx.data

# Datasets (large; tracked selectively only)
soil report/
soil report.zip
soil analysis/
soil_data.json
datasets/soil_report_all.json
*.zip
*.dmg
*.mp4

# Report-generation side-project (kept out of the product repo)
report_build/
output/
tmp/
Final_Project_Report_*
*.docx
*.pdf
audit/_raw/

# OS / editor
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.kilo/
:memory:.ses
