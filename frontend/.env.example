# Frontend - Local Development Environment Variables
# Copy this file to .env.local and fill in your values

# Vercel OIDC Token (for preview deployments)
# VERCEL_OIDC_TOKEN="your-vercel-oidc-token"

# Google OAuth Client ID (for Google Sign-In)
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# API Base URL (points to local Worker or deployed Worker)
# VITE_API_BASE_URL="http://localhost:8787"

# For production, these are set in Vercel dashboard