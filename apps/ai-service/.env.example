# AI Service - Local Development Environment Variables
# Copy this file to .env and fill in your values

# Service-to-service authentication token (must match Worker's AI_SERVICE_TOKEN)
SERVICE_TOKEN="local-dev-token-change-in-production"

# Path to ONNX model file (set when model is trained)
# MODEL_PATH="/app/models/disease_model.onnx"

# For local development without model, leave MODEL_PATH unset or point to non-existent file
# The service will return "model_unavailable" until a valid model is loaded

# Hugging Face API token (optional - for fallback disease detection)
# HF_API_TOKEN="your-huggingface-token"

# Logging level
LOG_LEVEL="INFO"