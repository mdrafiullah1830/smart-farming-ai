# Public frontend configuration
PUBLIC_API_BASE_URL=https://smart-farming-api.YOUR_SUBDOMAIN.workers.dev/api/v1

# Cloudflare Worker secrets (set with `wrangler secret put`, never commit values)
JWT_SECRET=
AI_SERVICE_TOKEN=

# Cloudflare Worker variables
ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app,http://localhost:3000,http://localhost:8080
AI_SERVICE_URL=https://YOUR_RENDER_SERVICE.onrender.com

# Render secret. It must match the Worker's AI_SERVICE_TOKEN.
SERVICE_TOKEN=
